{
  "format": "esp32-macro-keyboard-repository-fixtures",
  "version": 1,
  "cases": [
    { "name": "canonical repository", "kind": "canonical", "expected": { "ok": true } },
    { "name": "empty repository", "kind": "empty", "expected": { "ok": true } },
    { "name": "package name 64 bytes", "kind": "packageName", "count": 64, "expected": { "ok": true } },
    { "name": "package name 65 bytes", "kind": "packageName", "count": 65, "expected": { "ok": false, "code": "too_long", "path": "$.packages[0].name" } },
    { "name": "macro name 64 bytes", "kind": "macroName", "count": 64, "expected": { "ok": true } },
    { "name": "macro name 65 bytes", "kind": "macroName", "count": 65, "expected": { "ok": false, "code": "too_long", "path": "$.packages[0].macros[0].name" } },
    { "name": "macro source 4096 bytes", "kind": "macroSource", "count": 4096, "expected": { "ok": true } },
    { "name": "macro source 4097 bytes", "kind": "macroSource", "count": 4097, "expected": { "ok": false, "code": "too_long", "path": "$.packages[0].macros[0].source" } },
    { "name": "key press minimum", "kind": "keyPressMs", "value": 0, "expected": { "ok": true } },
    { "name": "key press maximum", "kind": "keyPressMs", "value": 10000, "expected": { "ok": true } },
    { "name": "key press below minimum", "kind": "keyPressMs", "value": -1, "expected": { "ok": false, "code": "invalid_timing", "path": "$.packages[0].macros[0].keyPressMs" } },
    { "name": "key press above maximum", "kind": "keyPressMs", "value": 10001, "expected": { "ok": false, "code": "invalid_timing", "path": "$.packages[0].macros[0].keyPressMs" } },
    { "name": "inter-key minimum", "kind": "interKeyMs", "value": 0, "expected": { "ok": true } },
    { "name": "inter-key maximum", "kind": "interKeyMs", "value": 10000, "expected": { "ok": true } },
    { "name": "inter-key below minimum", "kind": "interKeyMs", "value": -1, "expected": { "ok": false, "code": "invalid_timing", "path": "$.packages[0].macros[0].interKeyMs" } },
    { "name": "inter-key above maximum", "kind": "interKeyMs", "value": 10001, "expected": { "ok": false, "code": "invalid_timing", "path": "$.packages[0].macros[0].interKeyMs" } },
    { "name": "malformed root", "kind": "malformedRoot", "expected": { "ok": false, "code": "invalid_object", "path": "$" } },
    { "name": "malformed package", "kind": "malformedPackage", "expected": { "ok": false, "code": "invalid_object", "path": "$.packages[0]" } },
    { "name": "malformed macro", "kind": "malformedMacro", "expected": { "ok": false, "code": "invalid_object", "path": "$.packages[0].macros[0]" } },
    { "name": "duplicate package id", "kind": "duplicatePackage", "expected": { "ok": false, "code": "duplicate_id", "path": "$.packages[1].id" } },
    { "name": "duplicate macro id across packages", "kind": "duplicateMacro", "expected": { "ok": false, "code": "duplicate_id", "path": "$.packages[1].macros[0].id" } },
    { "name": "active package field", "kind": "activePackageId", "expected": { "ok": false, "code": "invalid_fields", "path": "$" } },
    { "name": "unknown root field", "kind": "unknownRoot", "expected": { "ok": false, "code": "invalid_fields", "path": "$" } },
    { "name": "unknown package field", "kind": "unknownPackage", "expected": { "ok": false, "code": "invalid_fields", "path": "$.packages[0]" } },
    { "name": "unknown macro field", "kind": "unknownMacro", "expected": { "ok": false, "code": "invalid_fields", "path": "$.packages[0].macros[0]" } },
    { "name": "non-finite timing", "kind": "nonFinite", "expected": { "ok": false, "code": "invalid_timing", "path": "$.packages[0].macros[0].keyPressMs" } },
    { "name": "sparse package array", "kind": "sparsePackages", "expected": { "ok": false, "code": "invalid_array", "path": "$.packages" } },
    { "name": "sparse macro array", "kind": "sparseMacros", "expected": { "ok": false, "code": "invalid_array", "path": "$.packages[0].macros" } },
    { "name": "prototype-bearing root", "kind": "prototypeRoot", "expected": { "ok": false, "code": "invalid_object", "path": "$" } }
  ]
}
