{
  "format": "esp32-macro-keyboard-api-routes",
  "version": 1,
  "routes": [
    {
      "method": "POST",
      "path": "/api/v1/setup",
      "access": "unprovisioned-only",
      "requestContentType": "application/json",
      "requestBodyLimit": "jsonBodyMaxBytes",
      "successStatus": 202,
      "responseContentType": "application/json"
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "access": "anonymous-configured-device",
      "requestContentType": "application/json",
      "requestBodyLimit": "jsonBodyMaxBytes",
      "successStatus": 200,
      "responseContentType": "application/json"
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/logout",
      "access": "authenticated",
      "requestContentType": null,
      "requestBodyLimit": 0,
      "successStatus": 204,
      "responseContentType": null
    },
    {
      "method": "GET",
      "path": "/api/v1/auth/session",
      "access": "authenticated",
      "requestContentType": null,
      "requestBodyLimit": 0,
      "successStatus": 200,
      "responseContentType": "application/json"
    },
    {
      "method": "GET",
      "path": "/api/v1/status",
      "access": "authenticated",
      "requestContentType": null,
      "requestBodyLimit": 0,
      "successStatus": 200,
      "responseContentType": "application/json"
    },
    {
      "method": "GET",
      "path": "/api/v1/limits",
