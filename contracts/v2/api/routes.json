      "requestBodyLimit": 0,
      "successStatus": 200,
      "responseContentType": "application/json"
    },
    {
      "method": "POST",
      "path": "/api/v1/blob",
      "access": "authenticated",
      "requestContentType": "application/gzip",
      "requestBodyLimit": "blobMaxBytes",
      "successStatus": 201,
      "responseContentType": "application/json"
    },
    {
      "method": "GET",
      "path": "/api/v1/blob/{blob_id}",
      "access": "authenticated",
      "requestContentType": null,
      "requestBodyLimit": 0,
      "successStatus": 200,
      "responseContentType": "application/gzip"
    },
    {
      "method": "DELETE",
