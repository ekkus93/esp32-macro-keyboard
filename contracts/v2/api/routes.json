      "responseContentType": null
    },
    {
      "method": "POST",
      "path": "/api/v1/send",
      "access": "authenticated",
      "requestContentType": "application/json",
      "requestBodyLimit": "jsonBodyMaxBytes",
      "successStatus": 202,
      "responseContentType": "application/json"
    },
    {
      "method": "GET",
      "path": "/api/v1/send",
      "access": "authenticated",
      "requestContentType": null,
      "requestBodyLimit": 0,
      "successStatus": 200,
      "responseContentType": "application/json"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/send",
      "access": "authenticated",
      "requestContentType": null,
      "requestBodyLimit": 0,
      "successStatus": 202,
      "responseContentType": "application/json"
    },
    {
      "method": "GET",
      "path": "/api/v1/settings",
      "access": "authenticated",
      "requestContentType": null,
      "requestBodyLimit": 0,
      "successStatus": 200,
      "responseContentType": "application/json"
    },
    {
      "method": "PUT",
      "path": "/api/v1/settings",
      "access": "authenticated",
      "requestContentType": "application/json",
      "requestBodyLimit": "jsonBodyMaxBytes",
      "successStatus": 200,
      "responseContentType": "application/json"
    },
