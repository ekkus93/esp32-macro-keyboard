menu "ESP32 Macro Keyboard"

# The device has no buttons. Confirmation and cancellation are serial-console
# commands (`confirm`, `cancel`) - see components/serial_console. The former
# button options are deliberately not kept as unused settings: a configurable
# GPIO for hardware that does not exist is how the cancel button ended up
# defaulted to GPIO4, a pin no devkit here exposes.
config APP_STATUS_LED_GPIO
    int "Status LED GPIO"
    range 0 48
    default 2

config APP_LED_ACTIVE_LEVEL
    int "LED active level"
    range 0 1
    default 1

config APP_MANUFACTURING_PROVISIONING_LOG
    bool "MANUFACTURING ONLY: print one-time provisioning credentials"
    default n
    help
        Enables an irreversible-warning UART banner followed by one-time AP and
        administrator credentials for controlled factory bring-up. Production
        and ordinary development builds must leave this disabled. The release
        configuration gate rejects any build with this option enabled.

endmenu
