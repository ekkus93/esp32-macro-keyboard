def require_once(text: str, needle: str, label: str) -> None:
    count = text.count(needle)
    if count != 1:
        raise SystemExit(f"{label}: expected exactly one occurrence, found {count}")

def replace_once(text: str, old: str, new: str, label: str) -> str:
    require_once(text, old, label)
    return text.replace(old, new, 1)

def section_bounds(text: str, start_heading: str, end_heading: str) -> tuple[int, int]:
    start = text.find(start_heading)
    if start < 0:
        raise SystemExit(f"missing section start: {start_heading}")
    end = text.find(end_heading, start + len(start_heading))
    if end < 0:
        raise SystemExit(f"missing section end: {end_heading}")
    return start, end

def insert_before_section(text: str, end_heading: str, marker: str, note: str) -> str:
    if marker in text:
        raise SystemExit(f"marker already present: {marker}")
    idx = text.find(end_heading)
    if idx < 0:
        raise SystemExit(f"missing insertion heading: {end_heading}")
    return text[:idx] + note.rstrip() + "\n\n" + text[idx:]

