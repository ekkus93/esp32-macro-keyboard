{
  "name": "esp32-macro-keyboard-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "stylelint": "stylelint 'src/**/*.css' --max-warnings=0",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "npm run build && node tests/browser/run-browser-tests.mjs && node tests/browser/run-h4-recovery-tests.mjs && node tests/browser/run-h5-storage-reconciliation-tests.mjs",
    "test:visual": "npm run build && node tests/browser/visual/run-visual-tests.mjs",
    "check:no-orphan-classes": "npm run build && node tests/browser/checkNoOrphanClasses.mjs",
    "check:status-badge-shapes": "npm run build && node tests/browser/checkStatusBadgeShapes.mjs",
    "audit:ci": "python3 ../scripts/check-npm-audit.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.11",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.6.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "markdownlint-cli2": "0.23.2",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "stylelint": "16.22.0",
    "stylelint-config-standard": "38.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
