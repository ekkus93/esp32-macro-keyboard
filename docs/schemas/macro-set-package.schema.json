{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/macro-set-package.schema.json",
  "title": "ESP32 Macro Keyboard macro-set package",
  "$comment": "The executable Phase 18 validator is authoritative and additionally enforces UTF-8 byte limits, UUID ownership, referential integrity, macro compilation, exact global dependencies, and the 512 KiB package limit before persistent mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_type",
    "sets",
    "macros"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_type": {
      "const": "set"
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/set"
      }
    },
    "macros": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/macro"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "$comment": "Canonical UUIDs are exactly 36 ASCII characters and therefore 36 UTF-8 bytes.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "revision",
        "name"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "$comment": "maxLength is a schema-level code-point limit; import validation must enforce APP_NAME_MAX_BYTES = 64 UTF-8 bytes.",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "revision",
        "set_id",
        "name",
        "source",
        "key_press_ms",
        "inter_key_ms"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "set_id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "$comment": "maxLength is a schema-level code-point limit; import validation must enforce APP_MACRO_NAME_MAX_BYTES = 64 UTF-8 bytes.",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "$comment": "maxLength is a schema-level code-point limit; import validation must enforce APP_MACRO_SOURCE_MAX_BYTES = 4096 UTF-8 bytes before compilation or mutation.",
          "maxLength": 4096
        },
        "key_press_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "inter_key_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
