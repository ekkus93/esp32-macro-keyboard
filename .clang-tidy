# Curated for this codebase. Three checks are disabled because they are
# empirically un-actionable here, not because they are unwanted. Each fires on a
# constraint we implement against but do not control (a third-party signature or
# a C-library limitation), and none has a per-finding exemption:
#   - clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling:
#     flags every memset/memcpy and demands the C11 Annex K *_s functions
#     (memset_s), which newlib/ESP-IDF does not provide, so the demanded fix
#     cannot be written on this toolchain.
#   - readability-non-const-parameter: its only finding is the `buffer` param of
#     the TinyUSB tud_hid_get_report_cb callback. The TinyUSB HID prototype
#     mandates a non-const uint8_t*, so making it const is a conflicting-types
#     error; the check has no per-parameter exemption.
#   - concurrency-mt-unsafe: its only finding is readdir() in the POSIX storage
#     backend. Its one mt-safe replacement, readdir_r, is deprecated on the glibc
#     host (and undeclared without a feature macro), breaking the -Werror host
#     build; storage access is single-threaded, so per-DIR* readdir is safe.
# misc-include-cleaner is enabled and enforced on all first-party and public
# standard-library symbols. Its IgnoreHeaders acts as a mapping list (the role
# IWYU mapping files play; ESP-IDF/newlib ship none): include-cleaner keys off
# the physical *defining* header, but ESP-IDF and newlib deliberately expose
# public umbrella headers over internal ones. Each ignore entry redirects the
# check from an internal header to its public umbrella, which stays enforced:
#   - esp-idf, managed_components: framework headers (public umbrella e.g.
#     esp_wifi.h, not internal esp_wifi_types_generic.h / portmacro.h).
#   - sys/_*, machine, sys/dirent.h: newlib private headers behind public
#     <fcntl.h> / <dirent.h> (which stay enforced via directly-declared symbols).
#   - unistd.h, errno.h: this tree also compiles on the glibc host (tests/host),
#     but include-cleaner analyses the xtensa/newlib DB, where these symbols are
#     attributed to internal/framework headers. The public <unistd.h>/<errno.h>
#     are required by the host build yet look unused to the check; ignore the
#     families so the required includes are kept, not flagged unused.
#   - cstddef, cstdint: the tool suggests C++ wrapper spellings for C stdlib
#     symbols; the C headers <stddef.h> / <stdint.h> are enforced instead.
# cognitive-complexity and magic-numbers are kept, tuned with IgnoreMacros so
# they measure first-party source rather than ESP_LOG/HW-register macro
# expansions.
# bugprone-easily-swappable-parameters is enforced on first-party functions we
# design. Its IgnoredParameterNames only exempts parameters whose adjacency is
# dictated by a third-party interface we implement, not by our own design:
#   - context: the leading void* of every ESP-IDF-style ops adapter callback.
#   - lhs, rhs (defaults): the two operands of a qsort/bsearch comparator.
#   - instance, report_id, report_type: the TinyUSB HID callback parameters
#     (tud_hid_get/set_report_cb), whose order and types are fixed by TinyUSB.
# Parameters we control are still flagged and were restructured, not exempted.
Checks: >
  -*,
  bugprone-*,
  cert-err34-c,
  cert-str34-c,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -readability-non-const-parameter,
  -concurrency-mt-unsafe
WarningsAsErrors: '*'
HeaderFilterRegex: '/firmware/(main/|components/|test_app/main/)'
FormatStyle: file
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: '.*esp-idf.*;.*managed_components.*;.*/machine/.*;.*/sys/_.*;.*/sys/dirent\.h;.*/unistd\.h;.*/errno\.h;cstddef;cstdint'
  bugprone-easily-swappable-parameters.IgnoredParameterNames: '"";iterator;Iterator;begin;Begin;end;End;first;First;last;Last;lhs;LHS;rhs;RHS;context;instance;report_id;report_type'
  readability-function-cognitive-complexity.IgnoreMacros: 'true'
  readability-magic-numbers.IgnoreMacros: 'true'
  readability-magic-numbers.IgnorePowersOf2IntegerValues: 'true'
